      "gpu_kernel_span_ns": "last matched kernel.end - first matched kernel.start",
      "gpu_kernel_union_ns": "sum(end-start) across all matched kernels",
      "gpu_idle_gap_ns": "gpu_kernel_span_ns - gpu_kernel_union_ns; a gap without a matched kernel in this trace scope, not a causal attribution"
