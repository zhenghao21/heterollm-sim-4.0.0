diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 5ae3b8d..80893a2 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2584,6 +2584,8 @@ static const void * ggml_cuda_graph_get_key(ggml_cgraph * cgraph) {
     return cgraph->nodes[0];
 }
 
+#include "native_cuda_graph_trace.inc"
+
 static bool ggml_cuda_graph_update_required(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph) {
     bool res = false;
 
@@ -2630,6 +2632,7 @@ static void ggml_cuda_graph_update_executable(ggml_backend_cuda_context * cuda_c
     ggml_cuda_graph * graph = cuda_ctx->cuda_graph(graph_key);
 
 #if CUDART_VERSION >= 12000
+    heterollm_graph_trace_event("update", graph_key);
     cudaGraphExecUpdateResultInfo result_info;
     cudaError_t stat = cudaGraphExecUpdate(graph->instance, graph->graph, &result_info);
 #else
@@ -2645,10 +2648,13 @@ static void ggml_cuda_graph_update_executable(ggml_backend_cuda_context * cuda_c
 
         // The pre-existing graph exec cannot be updated due to violated constraints
         // so instead clear error and re-instantiate
+        heterollm_graph_trace_event("update_failed", graph_key);
         (void)cudaGetLastError();
         CUDA_CHECK(cudaGraphExecDestroy(graph->instance));
+        heterollm_graph_trace_event("destroy_exec", graph_key);
         graph->instance = nullptr;
         CUDA_CHECK(cudaGraphInstantiate(&graph->instance, graph->graph, NULL, NULL, 0));
+        heterollm_graph_trace_event("reinstantiate", graph_key);
     } else {
         GGML_ASSERT(stat == cudaSuccess);
     }
@@ -4360,10 +4366,12 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
         if (use_cuda_graph && cuda_graph_update_required) { // End CUDA graph capture
             if (graph->graph != nullptr) {
                 CUDA_CHECK(cudaGraphDestroy(graph->graph));
+                heterollm_graph_trace_event("destroy_graph", graph_key);
                 graph->graph = nullptr;
             }
 
             CUDA_CHECK(cudaStreamEndCapture(cuda_ctx->stream(), &graph->graph));
+            heterollm_graph_trace_event("capture_end", graph_key);
             graph_evaluated_or_captured = true; // CUDA graph has been captured
 
             std::lock_guard<std::mutex> lock(ggml_cuda_lock);
@@ -4377,14 +4385,20 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
 
     if (use_cuda_graph) {
         ggml_cuda_graph * graph = cuda_ctx->cuda_graph(graph_key);
+        if (std::getenv("HETEROLLM_CUDA_GRAPH_CAPTURE_ONLY") != nullptr) {
+            heterollm_graph_trace_cuda_structure(graph->graph, graph_key);
+            return;
+        }
         if (graph->instance == nullptr) { // Create executable graph from captured graph.
             CUDA_CHECK(cudaGraphInstantiate(&graph->instance, graph->graph, NULL, NULL, 0));
+            heterollm_graph_trace_event("instantiate", graph_key);
         }
         if (cuda_graph_update_required) { // Update graph executable
             ggml_cuda_graph_update_executable(cuda_ctx, graph_key);
         }
         // Launch graph
         CUDA_CHECK(cudaGraphLaunch(graph->instance, cuda_ctx->stream()));
+        heterollm_graph_trace_event("replay", graph_key);
 #else
         GGML_UNUSED(graph_key);
         graph_evaluated_or_captured = true;
@@ -4413,6 +4427,24 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
 
     ggml_cuda_set_device(cuda_ctx->device);
+#ifdef USE_CUDA_GRAPH
+    heterollm_graph_trace_snapshot(cuda_ctx, cgraph);
+    if (std::getenv("HETEROLLM_CUDA_GRAPH_CAPTURE_ONLY") != nullptr) {
+        if (!ggml_cuda_graph_check_compability(cgraph)) GGML_ABORT("capture-only graph is incompatible");
+        const void * structural_key = ggml_cuda_graph_get_key(cgraph);
+        {
+            std::lock_guard<std::mutex> lock(ggml_cuda_lock);
+            ggml_cuda_lock_counter.fetch_add(1, std::memory_order_relaxed);
+        }
+        CUDA_CHECK(cudaStreamBeginCapture(cuda_ctx->stream(), cudaStreamCaptureModeRelaxed));
+        ggml_cuda_graph_evaluate_and_capture(cuda_ctx, cgraph, true, true, structural_key);
+        return GGML_STATUS_SUCCESS;
+    }
+    if (std::getenv("HETEROLLM_CUDA_GRAPH_DRY_RUN") != nullptr) {
+        if (!heterollm_graph_trace_file()) GGML_ABORT("dry-run requires structural trace output");
+        return GGML_STATUS_SUCCESS;
+    }
+#endif
 
     bool use_cuda_graph             = false;
     bool cuda_graph_update_required = false;
@@ -4428,6 +4460,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
         const bool graph_compatible = ggml_cuda_graph_check_compability(cgraph);
         if (graph_compatible) {
             const bool properties_changed = ggml_cuda_graph_update_required(cuda_ctx, cgraph);
+            heterollm_graph_trace_event(properties_changed ? "properties_changed" : "properties_stable", graph_key);
 
             if (!graph->warmup_complete) {
                 // Warmup: need at least 2 calls with no property change on the 2nd call
@@ -4461,8 +4494,12 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
         }
 
         CUDA_CHECK(cudaStreamBeginCapture(cuda_ctx->stream(), cudaStreamCaptureModeRelaxed));
+        heterollm_graph_trace_event("capture_begin", graph_key);
     }
 
+#ifdef USE_CUDA_GRAPH
+    if (!use_cuda_graph) heterollm_graph_trace_event("direct", graph_key);
+#endif
     ggml_cuda_graph_evaluate_and_capture(cuda_ctx, cgraph, use_cuda_graph, cuda_graph_update_required, graph_key);
 
     return GGML_STATUS_SUCCESS;
